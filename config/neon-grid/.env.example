# Copy to ~/.config/neon-grid/.env (chmod 600) and fill in. Never commit the real file.
# Needed only for the Search Console board; without it the board is skipped.
#
# Domain property in Google Search Console, e.g. example.com (not a URL)
NEON_GSC_DOMAIN=
# Service-account key with read access to that property (keep it outside the repository)
NEON_GSC_KEY=~/.config/neon-grid/gsc-key.json
# Python that has google-auth and google-api-python-client
NEON_GSC_PYTHON=/usr/bin/python3
# Sites to list even without search traffic, separated by commas (optional)
NEON_GSC_ALWAYS=
