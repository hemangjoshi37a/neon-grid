#!/usr/bin/env python3
"""Makes logging in faster: reads the files the X server and Cinnamon will need into memory
while the login screen is waiting. `neon-warm learn` (run from the desktop start script) notes
which files this PC really used, so updates are picked up by themselves. Only ever reads files."""
import os
import re
import sys
import time
from pathlib import Path

LIST = Path.home() / '.cache/neon-grid/warm.list'
LIMIT = 320 << 20                       # bytes in all
BIGGEST = 24 << 20                      # larger libraries are only used in small parts
NAMES = {'Xorg', 'cinnamon', 'cinnamon-sessio', 'cinnamon-launch', 'nemo-desktop', 'cinnamon-killer',
         'csd-xsettings', 'csd-power', 'csd-media-keys', 'csd-keyboard', 'csd-color', 'csd-background',
         'nm-applet', 'gnome-keyring-d', 'ibus-daemon', 'conky'}


def learn():
    files, rest = [], []
    for p in Path('/proc').iterdir():
        if not p.name.isdigit():
            continue
        try:
            name = (p / 'comm').read_text().strip()
            if name not in NAMES:
                continue
            into = files if name == 'Xorg' else rest
            for line in (p / 'maps').read_text().splitlines():
                f = line.split(None, 5)[-1]
                if f.startswith(('/usr/', '/lib', '/home/')) and '(deleted)' not in f:
                    into.append(f)
            into.append(os.readlink(p / 'exe'))
        except OSError:
            pass
    logs = sorted((Path.home() / '.local/share/xorg').glob('Xorg.*.log'))
    if logs:                            # drivers the server tries and drops again cost time too
        files[:0] = re.findall(r'Loading (/\S+\.so)', logs[-1].read_text(errors='replace'))
    files += rest                       # the X server comes first, then the desktop
    for d in ('/usr/share/cinnamon/js', '/usr/share/cinnamon/applets', '/usr/lib/x86_64-linux-gnu/cinnamon',
              '/usr/lib/x86_64-linux-gnu/muffin', str(Path.home() / '.local/share/cinnamon/extensions')):
        files += [str(f) for f in Path(d).rglob('*') if f.is_file()]
    files += ['/usr/bin/Xorg', '/usr/lib/xorg/Xorg', '/usr/bin/cinnamon-session', '/usr/bin/cinnamon',
              str(Path.home() / '.cache/neon-grid/splash.png'), str(Path.home() / '.local/share/neon-grid/neon-splash')]
    seen, out, total = set(), [], 0
    for f in files:
        try:
            r = os.path.realpath(f)
            size = os.stat(r).st_size
        except OSError:
            continue
        if r in seen or not os.path.isfile(r) or '/.cache/' in r and not r.endswith('splash.png') or total + size > LIMIT \
                or size > BIGGEST and '/xorg/' not in r:
            continue
        seen.add(r)
        out.append(r)
        total += size
    LIST.parent.mkdir(parents=True, exist_ok=True)
    tmp = LIST.with_suffix('.tmp')
    tmp.write_text('\n'.join(out) + '\n')
    os.replace(tmp, LIST)
    print(f'{len(out)} files, {total >> 20} MB')


def warm():
    t0, n, total = time.time(), 0, 0
    if not LIST.is_file():
        return
    for f in LIST.read_text().splitlines():
        try:
            fd = os.open(f, os.O_RDONLY | os.O_CLOEXEC)
        except OSError:
            continue
        try:
            while True:
                b = os.read(fd, 1 << 20)
                if not b:
                    break
                total += len(b)
            n += 1
        except OSError:
            pass
        finally:
            os.close(fd)
    print(f'{n} files, {total >> 20} MB in {time.time() - t0:.1f} s')


learn() if sys.argv[1:] == ['learn'] else warm()
