# Neon-Grid GRUB theme: wallpaper + Material You (generated). The glass panel, the logos and the
# heading are part of background.png; places are in percent, so they fit any resolution.
title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "stretch"
desktop-color: "@bg@"
terminal-font: "NeonMono Regular 16"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"

+ boot_menu {
  left = 31%
  top = 39%
  width = 38%
  height = 33%
  item_font = "NeonMono Regular 20"
  item_color = "@text@"
  selected_item_font = "NeonMono Regular 20"
  selected_item_color = "@bg@"
  item_height = 56
  item_padding = 8
  item_spacing = 10
  item_icon_space = 0
  icon_width = 0
  icon_height = 0
  selected_item_pixmap_style = "select_*.png"
  scrollbar = true
  scrollbar_width = 8
  scrollbar_thumb = "thumb_*.png"
}

+ progress_bar {
  id = "__timeout__"
  left = 33%
  top = 74%
  width = 34%
  height = 8
  text = ""
  show_text = false
  bar_style = "barbg_*.png"
  highlight_style = "barfg_*.png"
}
